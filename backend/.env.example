BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0
# Comma-separated exact origins; do not include paths.
CORS_ORIGIN=http://localhost:3000
APP_ORIGIN=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:4000

# Use a different database for testnet and mainnet.
# Supabase Dashboard -> Connect -> Transaction pooler (port 6543).
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=10
# Keep true for Supabase; false is only for disposable local PostgreSQL tests.
DATABASE_SSL=true
# Dedicated disposable Supabase/Postgres database used only by npm test.
TEST_DATABASE_URL=

FREE_SEARCH_LIMIT=5
FREE_SEARCH_BUDGET_USDC=0.01
SPONSORED_TREASURY_LIMIT_USDC=1.00
DISABLE_RESEARCH_GUARDRAILS=false
PAID_SEARCH_PRICE_USDC=0.05
PLATFORM_FEE_BPS=1000
AUTHOR_POOL_BPS=7000
PAYMENT_MODE=mock
SEARCH_PAYMENT_EXPIRY_MINUTES=15
RESEARCH_RUN_TIMEOUT_MINUTES=15
IP_HASH_SECRET=
TRUST_PROXY=false
ADMIN_TOKEN=
ADMIN_WALLETS=
TOKEN_SIGNING_SECRET=
AUTH_SESSION_HOURS=24
EVIDENCE_GRANT_MINUTES=10

RESEARCH_ASYNC=true
RESEARCH_WORKER_CONCURRENCY=2
RESEARCH_RATE_LIMIT_PER_HOUR=20
API_RATE_LIMIT_PER_MINUTE=180

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
GROQ_API_KEY=

NETRA_API_KEY=
NETRA_APP_NAME=maecenas-scholar
NETRA_ENVIRONMENT=development
NETRA_TRACE_CONTENT=true
NETRA_DEBUG=false
NETRA_DISABLE_BATCH=false

# Required for real payments. Testnet is the safe default for development.
ARC_ENVIRONMENT=testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
MAECENAS_AGENT_PRIVATE_KEY=
MAECENAS_AGENT_WALLET_ADDRESS=
# Must be a different wallet from the agent.
MAECENAS_TREASURY_WALLET_ADDRESS=
# Keep false on testnet. Mainnet will not start unless this is true.
MAINNET_PAYMENTS_ENABLED=false

# Mainnet uses the same keys in a separate deployment:
# ARC_ENVIRONMENT=mainnet
# ARC_RPC_URL=<mainnet-rpc>
# MAECENAS_AGENT_PRIVATE_KEY=<new-mainnet-key>
# MAECENAS_AGENT_WALLET_ADDRESS=<mainnet-agent>
# MAECENAS_TREASURY_WALLET_ADDRESS=<separate-mainnet-treasury>
# SUPABASE_DATABASE_URL=<mainnet-database>
# MAINNET_PAYMENTS_ENABLED=true

CIRCLE_API_KEY=
CIRCLE_WALLET_ID=
CIRCLE_ENTITY_SECRET=

MIN_GATEWAY_WITHDRAWAL_USDC=0.05
MAX_GATEWAY_WITHDRAWAL_FEE_USDC=0.05
